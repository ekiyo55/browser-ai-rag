# 待ち受けるアドレスとポート
RAG_HOST=127.0.0.1
RAG_PORT=8000

# トンネルや本番で外から呼ばれるときのホスト名（カンマ区切り）
# 例: RAG_PUBLIC_HOSTS=xxxx.trycloudflare.com
RAG_PUBLIC_HOSTS=

# 1 にすると、AI の自己紹介（initialize / server/discover の本文）をログに残す（第7・9章）
# 道具の引数は記録しない
RAG_LOG_HANDSHAKE=

# 公開する URL。設定するとログイン（OAuth）が有効になる（第17章）。手元での開発では空のまま
# 例: RAG_BASE_URL=https://book.mooma.style
RAG_BASE_URL=

# 検索の保存先・文書の置き場所（既定は ./data）
RAG_DATA_DIR=

# ---- メールのサーバー（第20〜22章） python -m browser_ai_rag.mail_server
# folder: data/mailbox を受信箱に見立てる（メールサーバーなしで試せる） / imap: 本物の受信箱
MAIL_BACKEND=folder
MAIL_IMAP_HOST=
MAIL_SMTP_HOST=
MAIL_USER=
MAIL_PASSWORD=
# 証明書の名前が接続先と違うときだけ（例: mail.example.com に接続、証明書は example.com）
MAIL_TLS_NAME=
# 送ってよい宛先（完全なアドレスか「@ドメイン」、カンマ区切り）。空なら、どこにも送れない
MAIL_ALLOWED_RECIPIENTS=
# この受信箱を使える利用者（空ならログインした全員）
MAIL_ALLOWED_USERS=
MAIL_PORT=8701

# ---- タイムカードのサーバー（第23〜24章） python -m browser_ai_rag.timecard_server
# 修正の申請を承認できる人（ユーザー名、カンマ区切り）。自分の申請は承認できない
TIMECARD_ADMINS=
# 勤務日の区切りに使う時差（日本は 9）
TIMECARD_UTC_OFFSET=9
TIMECARD_PORT=8702

# ---- 売上・案件のサーバー（第26章） python -m browser_ai_rag.count_server
# tools: 決まった道具（本番） / sql: AI に読むだけの SQL を書かせる（比べるための実験）
COUNT_MODE=tools
# 1 にすると、実験のときに AI が書いた SQL を記録する（架空のデータで試すときだけ）
COUNT_LOG_SQL=
COUNT_PORT=8703

# ---- 予定とタスクのサーバー（第27章） python -m browser_ai_rag.schedule_server
SCHEDULE_UTC_OFFSET=9
# 1 にすると、AI が渡した日時と曜日を記録する（実験のときだけ）
SCHEDULE_LOG_ARGS=
SCHEDULE_PORT=8704

# ---- 運用の窓口のサーバー（第28章） python -m browser_ai_rag.ops_server
# 最近のエラーと再起動を使える人（ユーザー名、カンマ区切り）
OPS_ADMINS=
# 証明書の期限を確かめる名前（例 book.mooma.style）
OPS_TLS_HOST=
# root で動く手伝いのスクリプト（deploy/book-ops を置いた場所）
OPS_HELPER=/usr/local/sbin/book-ops
OPS_PORT=8705

# ---- 六本をまとめた一本（第29章の比べるための実験） python -m browser_ai_rag.combined_server
ALL_PORT=8706
