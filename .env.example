# 待ち受けるアドレスとポート
RAG_HOST=127.0.0.1
RAG_PORT=8000

# トンネルや本番で外から呼ばれるときのホスト名（カンマ区切り）
# 例: RAG_PUBLIC_HOSTS=xxxx.trycloudflare.com
RAG_PUBLIC_HOSTS=

# 1 にすると、AI の自己紹介（initialize / server/discover の本文）をログに残す（第7・9章）
# 道具の引数は記録しない
RAG_LOG_HANDSHAKE=

# 公開する URL。設定するとログイン（OAuth）が有効になる（第17章）。手元での開発では空のまま
# 例: RAG_BASE_URL=https://book.mooma.style
RAG_BASE_URL=

# 検索の保存先・文書の置き場所（既定は ./data）
RAG_DATA_DIR=
